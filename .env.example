# Copy to .env for local development. Never commit real secrets.

# AI: auto uses Claude when ANTHROPIC_API_KEY is set, then OpenAI when OPENAI_API_KEY is set, otherwise the local
# development provider. Search embeddings use OpenAI when its key is set (Anthropic has none), else local hashing.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-5
# Let Claude search the web for current prices, rates and news (billed per search by Anthropic).
AI_WEB_SEARCH=true
# Google Gemini: a free tier (AI Studio key, no billing needed) that chats, reads photos and uses tools. On the free tier
# Google may use prompts and answers to improve its products. Set AI_PROVIDER=gemini to put Gemini first.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Each Gemini model has its own free limit; when one runs out, these take over in order (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.5-flash-lite
# Groq (console.groq.com): a free tier of open models, Faldo's backup when every Gemini model is out. Free providers
# back each other up; a paid one (Claude, OpenAI) only answers when AI_PROVIDER chooses it or is auto.
GROQ_API_KEY=
GROQ_CHAT_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_FAST_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b
GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database. postgres://, postgresql:// and ?sslmode=require URLs are accepted.
POSTGRES_PASSWORD=faldo
DATABASE_URL=postgresql+asyncpg://faldo_app:faldo_app@localhost:5432/faldo
MIGRATION_DATABASE_URL=postgresql+asyncpg://faldo:faldo@localhost:5432/faldo
# null = open a connection per request (serverless). queue = connection pool (long-running server).
DB_POOL=queue
# true when DATABASE_URL points at a PgBouncer/transaction pooler
DB_PGBOUNCER=false

# Web app URL: used for password reset links and the allowed Origin list
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Background jobs: worker = separate/in-process worker loop, inline = process after each request (serverless)
JOB_MODE=worker
RUN_WORKER_IN_API=true
# Protects the daily cron runs: /api/v1/internal/jobs/run and /api/v1/internal/checkins/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Storage and rate limits: local/memory for development, database for serverless
STORAGE_BACKEND=local
RECEIPT_STORAGE_DIR=var/receipts
RATE_LIMIT_BACKEND=memory

# Email for password resets. Without RESEND_API_KEY, reset links are written to the API log in development.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
EMAIL_FROM=Faldo <no-reply@yourdomain.com>

# Demo data
SEED_DEMO_PASSWORD=faldo-demo-2026
