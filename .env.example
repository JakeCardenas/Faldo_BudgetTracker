# Copy to .env for local development. Never commit real secrets.

# AI: auto uses OpenAI when OPENAI_API_KEY is set, otherwise the local development provider.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database. postgres://, postgresql:// and ?sslmode=require URLs are accepted.
POSTGRES_PASSWORD=faldo
DATABASE_URL=postgresql+asyncpg://faldo_app:faldo_app@localhost:5432/faldo
MIGRATION_DATABASE_URL=postgresql+asyncpg://faldo:faldo@localhost:5432/faldo
# null = open a connection per request (serverless). queue = connection pool (long-running server).
DB_POOL=queue
# true when DATABASE_URL points at a PgBouncer/transaction pooler
DB_PGBOUNCER=false

# Web app URL: used for password reset links and the allowed Origin list
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Background jobs: worker = separate/in-process worker loop, inline = process after each request (serverless)
JOB_MODE=worker
RUN_WORKER_IN_API=true
# Protects /api/v1/internal/jobs/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Storage and rate limits: local/memory for development, database for serverless
STORAGE_BACKEND=local
RECEIPT_STORAGE_DIR=var/receipts
RATE_LIMIT_BACKEND=memory

# Email for password resets. Without RESEND_API_KEY, reset links are written to the API log in development.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
EMAIL_FROM=Faldo <no-reply@yourdomain.com>

# Demo data
SEED_DEMO_PASSWORD=faldo-demo-2026
